/**
 * @fileOverview Firestore Security Rules for the Futsal Scoreboard application.
 *
 * Core Philosophy:
 * This ruleset implements an admin-based access control model for a central scoreboard document.
 * Only authenticated users with an admin role can modify the scoreboard data.
 * Anonymous users are allowed.
 *
 * Data Structure:
 * - /scoreboards/{scoreboardId}: Contains the main scoreboard data. Only one document with ID 'main_scoreboard' exists.
 * - /roles_admin/{userId}:  Documents in this collection indicate that a user is an admin.
 *
 * Key Security Decisions:
 * - Admin Role: The presence of a document in `/roles_admin/{userId}` grants admin privileges.
 * - No User Listing: The `list` operation is denied on the `/roles_admin` collection to prevent unauthorized enumeration of admin users.
 *
 * Denormalization for Authorization:
 * - Admin status is determined by the existence of a document in `/roles_admin/{userId}`, avoiding the need for `get()` calls to a separate user profile.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the main scoreboard document. Only admins can modify it.
     * @path /scoreboards/{scoreboardId}
     * @allow (get) Public read access to the scoreboard.
     * @allow (create, update, delete) Only admins can modify the scoreboard.
     * @deny  (create, update, delete) Non-admins cannot modify the scoreboard.
     * @principle Enforces admin-only writes for the scoreboard.
     */
    match /scoreboards/{scoreboardId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the roles_admin collection.  Presence of a document indicates admin status.
     * @path /roles_admin/{userId}
     * @allow (get, create, update, delete) Only admins can modify role assignments.
     * @deny (list) Prevents unauthorized listing of admin users.
     * @principle Enforces admin-only management of admin roles.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}