/**
 * @fileoverview Firestore Security Rules for the Futsal Scoreboard application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model where only users with admin privileges (defined by their presence in the `roles_admin` collection) can modify the central scoreboard document.  Read access to the scoreboard is public.
 *
 * Data Structure:
 * - `/scoreboards/{scoreboardId}`: Contains the real-time state of the scoreboard.  The `scoreboardId` is expected to be 'main_scoreboard'.
 * - `/roles_admin/{userId}`:  A collection where the existence of a document for a given `userId` signifies that the user is an administrator.
 *
 * Key Security Decisions:
 * - Public read access for the scoreboard to allow all views to display the current state.
 * - Strict admin-only write access to prevent unauthorized modification of the scoreboard.
 * - No user listing is permitted.
 * - Authorization Independence:  Admin status is determined solely by the presence of a document in the `/roles_admin/{userId}` collection, avoiding the need for `get()` calls in the scoreboard rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the central scoreboard document.
     * @path /scoreboards/{scoreboardId}
     * @allow get, list: Anyone can read the scoreboard.
     * @allow create, update, delete: Only admins can modify the scoreboard.
     * @deny create, update, delete: Non-admins cannot modify the scoreboard.
     * @principle Role-based access control. Public read, admin-only write.
     */
    match /scoreboards/{scoreboardId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the admin role collection.
     * @path /roles_admin/{userId}
     * @allow get: Any signed-in user can check if they are an admin.
     * @allow create: Only a server or trusted function should be able to assign admin roles.
     * @allow update: No updates allowed
     * @allow delete: Only a server or trusted function should be able to remove admin roles.
     * @deny list: Listing admin roles is not permitted.
     * @deny create: if false;
     * @principle Role definition through document existence.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      allow list: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}