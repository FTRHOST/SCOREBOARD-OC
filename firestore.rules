/**
 * @fileOverview Firestore Security Rules for the Futsal Scoreboard application.
 *
 * Core Philosophy:
 * This ruleset enforces an admin-only access model for the central scoreboard data.
 * Only users whose UIDs are present in the `/roles_admin/{userId}` collection are authorized to modify the scoreboard.
 *
 * Data Structure:
 * - /scoreboards/{scoreboardId}: Contains the central scoreboard data. There should be one document with the ID 'main_scoreboard'.
 * - /roles_admin/{userId}: Collection of admin user roles. The existence of a document for a given userId indicates that the user is an admin.
 *
 * Key Security Decisions:
 * - Scoreboard data is strictly controlled; only admins can modify it.
 * - User listing is disallowed for the `roles_admin` collection.
 * - Authorization is based on the existence of a document in the `roles_admin` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rule for the central scoreboard document. Only admins can create, update, or delete.
     * @path /scoreboards/{scoreboardId}
     * @allow (create) An admin user with UID 'admin123' creates the scoreboard document at /scoreboards/main_scoreboard.
     * @deny (create) A non-admin user tries to create the scoreboard document.
     * @allow (update) An admin user with UID 'admin123' updates the scoreboard document at /scoreboards/main_scoreboard.
     * @deny (update) A non-admin user tries to update the scoreboard document.
     * @allow (delete) An admin user with UID 'admin123' deletes the scoreboard document at /scoreboards/main_scoreboard.
     * @deny (delete) A non-admin user tries to delete the scoreboard document.
     * @principle Enforces admin-only access for scoreboard modifications.
     */
    match /scoreboards/{scoreboardId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the admin roles collection. Only admins can create, update or delete admin roles.
     * @path /roles_admin/{userId}
     * @allow (create) A user with UID 'admin123' creates their own admin role document at /roles_admin/admin123.
     * @deny (create) A user with UID 'user123' attempts to create an admin role document for 'admin456'.
     *
     * @principle Enforces self-creation for admin roles, restricting management to authorized users.
     */
    match /roles_admin/{userId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}