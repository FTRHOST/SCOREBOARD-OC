/**
 * @fileoverview Firestore Security Rules for the Futsal Scoreboard application.
 *
 * Core Philosophy:
 * This ruleset enforces an admin-only access model for modifying the main scoreboard data.
 * Only users who are registered as admins in the `roles_admin` collection can update the scoreboard.
 * Read access is public.
 *
 * Data Structure:
 * - /scoreboards/{scoreboardId}: Contains the main scoreboard data. Only one document with ID 'main_scoreboard' is expected.
 * - /roles_admin/{userId}: A collection to store admin user roles. The presence of a document with a user ID in this collection grants admin access.
 *
 * Key Security Decisions:
 * - Only authenticated admins can modify the scoreboard.
 * - Unauthenticated users can read scoreboard data.
 * - Scoreboard listing is public.
 * - The security model relies on the existence of documents in the `roles_admin` collection to grant admin privileges.
 * - To ensure Authorization Independence no `get()` calls are used, relying on the presence of a document in roles_admin.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the main scoreboard document. Only admins can write.
     * @path /scoreboards/{scoreboardId}
     * @allow get, list: Anyone can read the scoreboard.
     * @allow create, update, delete: Only admins can modify the scoreboard.
     * @deny create, update, delete: Non-admins cannot modify the scoreboard.
     * @principle Enforces admin-only access for scoreboard writes.
     */
    match /scoreboards/{scoreboardId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the admin roles collection.
     * @path /roles_admin/{userId}
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if request.auth.uid == userId && isSignedIn();
      allow update: if request.auth.uid == userId && isSignedIn();
      allow delete: if request.auth.uid == userId && isSignedIn();
    }

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is an admin based on the existence of a document in the roles_admin collection.
    function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

  }
}